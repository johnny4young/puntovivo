+++ b/out/util/fetchDownload.js
@@ -0,0 +1,74 @@
+"use strict";
+const { downloadArtifact } = require("@electron/get");
+const { EnvHttpProxyAgent } = require("undici");
+
+const FETCH_OPTION_KEYS = new Set(["quiet", "getProgressCallback", "headers", "method", "body", "cache", "credentials", "integrity", "keepalive", "mode", "redirect", "referrer", "referrerPolicy", "duplex", "priority"]);
+// fetch reports transport failures as TypeError("fetch failed" / "terminated")
+// with the socket error as its cause. Map them onto the errno codes builder's
+// bounded retry classification already recognises.
+const UNDICI_TRANSPORT_CODES = {
+    UND_ERR_SOCKET: "ECONNRESET",
+    UND_ERR_CONNECT_TIMEOUT: "ETIMEDOUT",
+    UND_ERR_HEADERS_TIMEOUT: "ETIMEDOUT",
+    UND_ERR_BODY_TIMEOUT: "ETIMEDOUT",
+};
+
+// @electron/get 5 uses native fetch, not got. Never silently pass got's agent
+// or timeout objects to fetch: neither is honoured by the Fetch API.
+async function downloadWithFetch(config) {
+    const { timeout, agent, signal, dispatcher, ...options } = config.downloadOptions ?? {};
+    if (agent !== undefined) {
+        throw new Error("electronDownload.downloadOptions.agent is a legacy got option; use a fetch dispatcher or HTTP_PROXY/HTTPS_PROXY/NO_PROXY instead");
+    }
+    for (const key of Object.keys(options)) {
+        if (!FETCH_OPTION_KEYS.has(key)) throw new Error(`Unsupported electronDownload fetch option: ${key}`);
+    }
+    if (dispatcher !== undefined && (!dispatcher || typeof dispatcher.dispatch !== "function")) {
+        throw new Error("electronDownload dispatcher must implement the fetch dispatch contract");
+    }
+    let requestTimeout = 10 * 60 * 1000;
+    if (timeout !== undefined) {
+        if (typeof timeout === "number") {
+            requestTimeout = timeout;
+        } else if (timeout && typeof timeout === "object" && Object.keys(timeout).length === 1 && "request" in timeout) {
+            requestTimeout = timeout.request;
+        } else {
+            throw new Error("electronDownload timeout must be a positive request deadline");
+        }
+    }
+    if (!Number.isSafeInteger(requestTimeout) || requestTimeout <= 0 || requestTimeout > 2147483647) {
+        throw new Error("electronDownload timeout must be a positive request deadline");
+    }
+    const deadline = AbortSignal.timeout(requestTimeout);
+    const combinedSignal = signal ? AbortSignal.any([signal, deadline]) : deadline;
+    const ownedDispatcher = dispatcher === undefined ? new EnvHttpProxyAgent() : undefined;
+    try {
+        return await downloadArtifact({
+            ...config,
+            downloadOptions: { ...options, signal: combinedSignal, dispatcher: dispatcher ?? ownedDispatcher },
+        });
+    } catch (error) {
+        // Preserve builder's existing bounded retry classification without
+        // turning a fetch status/timeout into an unbounded generic retry.
+        // Only this adapter's own deadline is a retryable timeout; a caller
+        // signal aborted with a TimeoutError reason stays a final cancellation.
+        if (error?.name === "TimeoutError" && deadline.aborted && !signal?.aborted) {
+            const timeoutError = new Error(error.message, { cause: error });
+            timeoutError.name = "TimeoutError";
+            timeoutError.code = "ETIMEDOUT";
+            throw timeoutError;
+        }
+        if (error?.response && typeof error.response.status === "number") {
+            error.response.statusCode = error.response.status;
+            // An unread error body keeps its request open, which would stall the
+            // dispatcher close below until the deadline. Release it now.
+            await error.response.body?.cancel().catch(() => undefined);
+        } else if (error?.name === "TypeError" && error.code === undefined && typeof error.cause?.code === "string") {
+            error.code = UNDICI_TRANSPORT_CODES[error.cause.code] ?? error.cause.code;
+        }
+        throw error;
+    } finally {
+        if (ownedDispatcher) await ownedDispatcher.close();
+    }
+}
+exports.downloadWithFetch = downloadWithFetch;

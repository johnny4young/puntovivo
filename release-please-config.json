{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "ad3fa772151e0a869c0386a8d84e3a803edda3ed",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "puntovivo",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "draft": false,
      "prerelease": false,
      "bump-minor-pre-major": false,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": [
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/desktop/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/server/package.json", "jsonpath": "$.version" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Funcionalidades" },
        { "type": "fix", "section": "Correcciones" },
        { "type": "perf", "section": "Rendimiento" },
        { "type": "refactor", "section": "Refactorizaciones" },
        { "type": "revert", "section": "Reversiones" },
        { "type": "docs", "section": "Documentación", "hidden": true },
        { "type": "build", "section": "Compilación", "hidden": true },
        { "type": "ci", "section": "CI/CD", "hidden": true },
        { "type": "chore", "section": "Varios", "hidden": true },
        { "type": "test", "section": "Pruebas", "hidden": true },
        { "type": "style", "section": "Estilos", "hidden": true }
      ]
    }
  }
}

---
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { useTranslations } from '../i18n/index.js';
import { localizedHref, sectionHref } from '../lib/paths.js';

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

// Icon per pending external condition (order matches estado.pending).
const PENDING_ICONS = ['file-check-2', 'shield-check', 'printer', 'store'];

const pending = t('estado.pending');
---

<PageHeader
  kicker={t('estado.kicker')}
  lead={t('estado.lead')}
  crumbs={[
    { label: t('estado.crumbInicio'), href: localizedHref(base, lang, '/') },
    { label: t('estado.crumbEmpresa') },
    { label: t('estado.crumbEstado') },
  ]}
>
  <Fragment slot="title">{t('estado.title')}</Fragment>
</PageHeader>

<section class="pv-shell pv-section">
  <div class="pv-card st-built">
    <h2>{t('estado.builtTitle')}</h2>
    <p>{t('estado.builtDesc')}</p>
    <a class="pv-btn pv-btn-outline" href={sectionHref(base, lang, '#modules')}>
      {t('estado.builtCta')}
    </a>
  </div>

  <h2 class="st-pending-title">{t('estado.pendingTitle')}</h2>
  <div class="pv-features">
    {
      pending.map((item, i) => (
        <div class="pv-card pv-feature">
          <span class="glyph">
            {PENDING_ICONS[i] && <Icon raw name={PENDING_ICONS[i]} size={20} />}
          </span>
          <h3>{item.h}</h3>
          <p>{item.p}</p>
        </div>
      ))
    }
  </div>

  <div class="pv-card st-honest">
    <h2>{t('estado.honestTitle')}</h2>
    <p>{t('estado.honestDesc')}</p>
    <p class="src">{t('estado.sourceNote')}</p>
  </div>
</section>

<style>
  .st-built,
  .st-honest {
    padding: 1.6rem;
    display: grid;
    gap: 0.8rem;
    justify-items: start;
  }
  .st-pending-title {
    margin: 2.2rem 0 1rem;
    font-size: 1.35rem;
  }
  .st-honest {
    margin-top: 2rem;
  }
  .st-honest .src {
    font-size: 0.85rem;
    opacity: 0.75;
  }
</style>

---
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { useTranslations } from '../i18n/index.js';
import { localizedHref } from '../lib/paths.js';

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

// Verbatim CSV sample — SKUs / barcodes are data, not translated.
const SAMPLE_CSV = `nombre,sku,descripcion,codigo de barras,precio,costo,stock inicial,stock minimo,iva,controlar lotes
Arepa de queso · Pack 12,ARQ-12-PV,Paquete de 12 unidades,7705412000123,9500,5800,24,6,5,no
Café tinto molido 500 g,CAF-500-TIN,Café tostado y molido,7702045009982,19900,12200,18,4,5,no
Bolsa reciclable mediana,BLS-M-RCY,Bolsa para entrega,7705781100456,1200,420,50,10,19,no
Leche larga vida 1 L,LCH-1L-LV,Caja de un litro,7702521011234,5400,3400,0,6,0,si`;

const LEVEL_LABELS = {
  auto: t('migracion.levelAuto'),
  asistida: t('migracion.levelAsistida'),
};
const levelLabel = level => LEVEL_LABELS[level] ?? t('migracion.levelManual');

const sources = t('migracion.sources');
const selected = sources[0];
const steps = t('migracion.steps');
const mapping = t('migracion.mapping');
const faq = t('migracion.faq');
---

<PageHeader
  kicker={t('migracion.kicker')}
  lead={t('migracion.lead')}
  crumbs={[
    { label: t('migracion.crumbInicio'), href: localizedHref(base, lang, '/') },
    { label: t('migracion.crumbRecursos') },
    { label: t('migracion.crumbMigracion') },
  ]}
  badges={[
    { label: t('migracion.badgeTime'), tone: 'pv-badge-primary' },
    { label: t('migracion.badgeHuman'), tone: 'pv-badge-amber' },
    { label: t('migracion.badgeNoDowntime'), tone: 'pv-badge-success' },
  ]}
>
  <Fragment slot="title">
    {t('migracion.titleA')}<em>{t('migracion.titleEm')}</em>{t('migracion.titleB')}
  </Fragment>

  <div class="mg-picker" slot="aside" data-source-picker>
    <div class="mg-picker-head">
      <Icon name="git-branch" size={16} color="var(--primary-700)" />
      <span>{t('migracion.pickerHead')}</span>
    </div>
    <div class="mg-picker-grid">
      {
        sources.map(s => (
          <button
            type="button"
            class={'mg-src' + (s.id === selected.id ? ' on' : '')}
            data-source-id={s.id}
            data-source-label={s.t}
          >
            <span class="t">{s.t}</span>
            <span class="d">{s.d}</span>
            <span class={'lvl lvl-' + s.level}>{levelLabel(s.level)}</span>
          </button>
        ))
      }
    </div>
    <div class="mg-picker-foot">
      <Icon name="arrow-right" size={12} color="var(--primary-700)" />
      {t('migracion.pickerFootA')} <b data-source-selected>{selected.t}</b>
      {t('migracion.pickerFootB')} <em>{t('migracion.pickerFootEm')}</em>
    </div>
  </div>
</PageHeader>

<section class="pv-shell pv-section" id="pasos">
  <div class="head">
    <span class="pv-kicker">{t('migracion.stepsKicker')}</span>
    <h2 class="pv-display">{t('migracion.stepsTitle')}</h2>
  </div>
  <ol class="mg-steps">
    {
      steps.map(s => (
        <li class="mg-step">
          <div class="mg-step-side">
            <span class="num">{s.n}</span>
            <span class="time">
              <Icon name="file-text" size={11} /> {s.time}
            </span>
          </div>
          <div class="mg-step-body">
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <ul>
              {s.checks.map(c => (
                <li class={c.ok ? 'ok' : 'warn'}>
                  <Icon name={c.ok ? 'check' : 'alert-triangle'} size={12} />
                  {c.t}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<section class="pv-shell pv-section">
  <div class="head">
    <span class="pv-kicker">{t('migracion.compatKicker')}</span>
    <h2 class="pv-display">{t('migracion.compatTitle')}</h2>
    <p class="desc">{t('migracion.compatDesc')}</p>
  </div>
  <div class="mg-mapping">
    <div class="mg-tr hd">
      <span>{t('migracion.mapColSystem')}</span>
      <span>{t('migracion.mapColFile')}</span>
      <span>{t('migracion.mapColSku')}</span>
      <span>{t('migracion.mapColName')}</span>
      <span>{t('migracion.mapColCost')}</span>
      <span>{t('migracion.mapColPrice')}</span>
      <span>{t('migracion.mapColIva')}</span>
      <span>{t('migracion.mapColStock')}</span>
      <span>{t('migracion.mapColLevel')}</span>
    </div>
    {
      mapping.map(m => (
        <div class="mg-tr">
          <span class="from">{m.from}</span>
          <span class="mono">{m.csv}</span>
          <span class="mono">{m.sku}</span>
          <span class="mono">{m.desc}</span>
          <span class="mono">{m.cost}</span>
          <span class="mono">{m.price}</span>
          <span class="mono">{m.iva}</span>
          <span class="mono">{m.stock}</span>
          <span class={'level ' + m.level.toLowerCase()}>{m.level}</span>
        </div>
      ))
    }
  </div>
</section>

<section class="pv-shell pv-section">
  <div class="head">
    <span class="pv-kicker">{t('migracion.sampleKicker')}</span>
    <h2 class="pv-display">{t('migracion.sampleTitle')}</h2>
    <p class="desc">{t('migracion.sampleDesc')}</p>
  </div>
  <div class="mg-sample">
    <div class="mg-sample-head">
      <span class="tab on">{t('migracion.sampleTab1')}</span>
      <span class="spacer"></span>
      <a
        class="dl"
        href={`data:text/csv;charset=utf-8,${encodeURIComponent(SAMPLE_CSV)}`}
        download="plantilla-puntovivo.csv"
      >
        <Icon name="download" size={13} /> {t('migracion.sampleDownload')}
      </a>
    </div>
    <pre class="mg-sample-pre">{SAMPLE_CSV}</pre>
    <div class="mg-sample-foot">
      <Icon name="info" size={12} /> {t('migracion.sampleFootA')} <span class="mono">0</span>{
        t('migracion.sampleFootB')
      } <span class="mono">EX</span>.
    </div>
  </div>
</section>

<section class="pv-shell pv-section" id="faq">
  <div class="head">
    <span class="pv-kicker">{t('migracion.faqKicker')}</span>
    <h2 class="pv-display">{t('migracion.faqTitle')}</h2>
  </div>
  <div class="mg-faq">
    {
      faq.map(({ q, a }) => (
        <details>
          <summary>
            {q}
            <span class="plus">+</span>
          </summary>
          <div class="ans">{a}</div>
        </details>
      ))
    }
  </div>
</section>

<section class="pv-shell pv-section">
  <div class="mg-cta">
    <div>
      <span class="pv-kicker">{t('migracion.ctaKicker')}</span>
      <h2
        class="pv-display"
        style="margin:8px 0 6px;font-size:clamp(24px, 2.8vw, 32px);color:var(--secondary-950);letter-spacing:-0.02em;line-height:1.1"
      >
        {t('migracion.ctaTitle')}
      </h2>
      <p style="margin:0;color:var(--fg2);font-size:14.5px">{t('migracion.ctaDesc')}</p>
    </div>
    <div style="display:inline-flex;gap:10px;flex-wrap:wrap">
      <a class="pv-btn pv-btn-primary" href={localizedHref(base, lang, '/contacto')}>
        <Icon name="calendar" size={14} /> {t('migracion.ctaSchedule')}
      </a>
      <a class="pv-btn pv-btn-outline" href={localizedHref(base, lang, '/docs')}>
        <Icon name="book-open" size={14} /> {t('migracion.ctaRead')}
      </a>
    </div>
  </div>
</section>

<script>
  import '../scripts/source-picker.js';
</script>

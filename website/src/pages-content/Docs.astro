---
import PageHeader from '../components/PageHeader.astro';
import { localizedHref } from '../lib/paths.js';
import { REPO_URL } from '../lib/release.js';
import es from '../content/manual/es.json';
import en from '../content/manual/en.json';
import '../styles/manual.css';

const { lang } = Astro.props;
const { ui, tasks } = lang === 'en' ? en : es;
const base = import.meta.env.BASE_URL;
const href = route => localizedHref(base, lang, route);
const names = new Map(tasks.map(task => [task.id, task.title]));
const resources = lang === 'en'
  ? [['/migracion', 'Import a catalog'], ['/atajos', 'Keyboard shortcuts'], ['/releases', 'Releases'], ['/estado', 'Product status'], ['/roadmap', 'Future work']]
  : [['/migracion', 'Importar un catálogo'], ['/atajos', 'Atajos de teclado'], ['/releases', 'Versiones'], ['/estado', 'Estado del producto'], ['/roadmap', 'Trabajo futuro']];
---

<main class="manual" id="manual">
  <a class="manual-skip" href="#manual-tasks">{ui.skip}</a>
  <PageHeader kicker={ui.kicker} lead={ui.lead} crumbs={[
    { label: ui.home, href: href('/') }, { label: ui.kicker },
  ]}>
    <Fragment slot="title">{ui.title}</Fragment>
    <a class="pv-link" href={localizedHref(base, lang === 'es' ? 'en' : 'es', '/docs')} data-manual-language data-lang-switch={lang === 'es' ? 'en' : 'es'} hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'}>
      {lang === 'es' ? 'Read this manual in English' : 'Leer este manual en español'} →
    </a>
  </PageHeader>

  <div class="pv-shell manual-layout">
    <aside class="manual-index">
      <details open data-manual-index>
        <summary class="pv-label">{ui.index}</summary>
        <nav aria-label={ui.index}>
        <ol>{tasks.map(task => <li><a href={`#${task.id}`} data-manual-jump>{task.title}</a></li>)}</ol>
      </nav>
      <ul class="manual-resources">{resources.map(([route, label]) => <li><a href={href(route)}>{label} →</a></li>)}</ul>
      </details>
    </aside>

    <div class="manual-body">
      <form role="search" class="manual-search" data-manual-search hidden>
        <label for="manual-query">{ui.search}</label>
        <input id="manual-query" type="search" placeholder={ui.placeholder} aria-describedby="manual-search-hint" autocomplete="off" />
        <p id="manual-search-hint">{ui.searchHint}</p>
        <div class="manual-search-actions">
          <p role="status" aria-live="polite" aria-atomic="true" data-manual-results data-template={ui.results} data-template-one={ui.resultsOne}></p>
          <button type="reset">{ui.clear}</button>
        </div>
      </form>

      <section class="manual-version" aria-labelledby="manual-version-title">
        <h2 id="manual-version-title">{ui.versionTitle}</h2>
        <p>{ui.version}</p>
        <a href={`${REPO_URL}/releases/tag/v1.15.1`}>v1.15.1 →</a>
      </section>

      <section aria-labelledby="manual-platforms-title" class="manual-platforms">
        <h2 id="manual-platforms-title">{ui.platformTitle}</h2>
        <dl>{ui.platforms.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>
      </section>


      <noscript><p>{ui.nojs}</p></noscript>
      <p data-manual-empty hidden>{ui.empty}</p>

      <div id="manual-tasks" tabindex="-1">
        {tasks.map((task, index) => (
          <article id={task.id} data-manual-task aria-labelledby={`${task.id}-title`} tabindex="-1">
            <header>
              <p class="pv-kicker">{String(index + 1).padStart(2, '0')} · {task.where}</p>
              <h2 id={`${task.id}-title`}>{task.title}</h2>
              <p class="manual-intro">{task.intro}</p>
            </header>
            <h3>{ui.steps}</h3>
            <ol class="manual-steps">{task.steps.map(step => <li>{step}</li>)}</ol>
            {task.details && <dl class="manual-details">{task.details.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>}
            <aside class="manual-check"><h3>{ui.check}</h3><p>{task.check}</p></aside>
            <footer class="manual-task-footer">
              <p>{ui.related}: {task.related.map((id, i) => <><a href={`#${id}`} data-manual-jump>{names.get(id)}</a>{i < task.related.length - 1 ? ' · ' : ''}</>)}</p>
              <a href={`${REPO_URL}/blob/v1.15.1/${task.source}`}>{ui.source} ↗</a>
            </footer>
          </article>
        ))}
      </div>
      <section class="manual-help" aria-labelledby="manual-help-title">
        <h2 id="manual-help-title">{ui.help}</h2>
        <p>{ui.helpText}</p>
        <a class="pv-link" href={href('/contacto')}>{ui.contact} →</a>
      </section>
    </div>
  </div>
</main>

<script>
  import '../scripts/manual.js';
</script>

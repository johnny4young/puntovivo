{
  "name": "@puntovivo/server",
  "version": "1.15.6",
  "description": "Puntovivo Backend Server - Fastify + Drizzle + SQLite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./audit-anchor": {
      "import": "./dist/services/audit-anchor.js",
      "types": "./dist/services/audit-anchor.d.ts"
    }
  },
  "scripts": {
    "native:node": "node ../../scripts/ensure-native-runtime.mjs node",
    "native:ensure:node": "node ../../scripts/ensure-native-runtime.mjs node",
    "build": "tsc && node ./scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit && pnpm run typecheck:tests",
    "dev": "pnpm run native:ensure:node && tsx watch src/standalone-development.ts",
    "dev:once": "pnpm run native:ensure:node && tsx src/standalone-development.ts",
    "start": "pnpm run native:ensure:node && node dist/standalone-production.js",
    "test": "pnpm run native:ensure:node && vitest run",
    "test:watch": "pnpm run native:ensure:node && vitest",
    "test:coverage": "pnpm run native:ensure:node && vitest run --coverage",
    "test:perf:trpc": "pnpm run native:ensure:node && node scripts/run-trpc-latency-gate.mjs",
    "test:perf:store": "pnpm run native:ensure:node && node scripts/run-store-profile-gate.mjs",
    "test:perf:search": "pnpm run native:ensure:node && node scripts/run-product-search-profile-gate.mjs",
    "test:perf:audit": "pnpm run native:ensure:node && node scripts/run-audit-chain-profile-gate.mjs",
    "test:coverage:html": "pnpm run native:ensure:node && vitest run --coverage --coverage.reporter=text --coverage.reporter=text-summary --coverage.reporter=html --coverage.reporter=json --coverage.reporter=lcov",
    "lint": "eslint src --ext .ts",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:dev": "pnpm run native:ensure:node && tsx src/scripts/seed-dev.ts",
    "benchmark:invoice-ocr": "pnpm run native:ensure:node && tsx scripts/benchmark-invoice-ocr.ts",
    "benchmark:invoice-ocr:regen": "node scripts/generate-invoice-ocr-fixtures.mjs",
    "benchmark:payment-reconciliation": "pnpm run native:ensure:node && tsx scripts/benchmark-payment-reconciliation.ts",
    "benchmark:product-embeddings": "pnpm run native:ensure:node && tsx src/scripts/benchmark-product-embeddings.ts",
    "benchmark:vector-storage": "pnpm run native:ensure:node && tsx src/scripts/benchmark-vector-storage.ts",
    "contract:snapshot": "pnpm run build && node ./scripts/update-trpc-contract-snapshot.mjs",
    "prebuild": "node ../../scripts/ensure-shared-build.mjs",
    "predev": "node ../../scripts/ensure-shared-build.mjs",
    "pretest": "node ../../scripts/ensure-shared-build.mjs",
    "pretest:watch": "node ../../scripts/ensure-shared-build.mjs",
    "pretest:coverage": "node ../../scripts/ensure-shared-build.mjs",
    "pretest:perf:trpc": "node ../../scripts/ensure-shared-build.mjs",
    "pretest:perf:store": "node ../../scripts/ensure-shared-build.mjs",
    "pretest:perf:search": "node ../../scripts/ensure-shared-build.mjs",
    "pretest:perf:audit": "node ../../scripts/ensure-shared-build.mjs",
    "pretest:coverage:html": "node ../../scripts/ensure-shared-build.mjs",
    "preseed:dev": "node ../../scripts/ensure-shared-build.mjs",
    "prebenchmark:invoice-ocr": "node ../../scripts/ensure-shared-build.mjs",
    "prebenchmark:invoice-ocr:regen": "node ../../scripts/ensure-shared-build.mjs",
    "prebenchmark:payment-reconciliation": "node ../../scripts/ensure-shared-build.mjs",
    "prebenchmark:product-embeddings": "node ../../scripts/ensure-shared-build.mjs",
    "prebenchmark:vector-storage": "node ../../scripts/ensure-shared-build.mjs",
    "typecheck:tests": "node --test scripts/check-test-types.test.mjs && node scripts/check-test-types.mjs",
    "typecheck:tests:update": "node scripts/check-test-types.mjs --write"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/openai": "^4.0.105",
    "@ai-sdk/provider": "^4.0.34",
    "@ai-sdk/provider-utils": "^5.0.71",
    "@aws-sdk/client-textract": "^3.1160.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.6",
    "@fastify/rate-limit": "^11.2.1",
    "@puntovivo/shared": "workspace:*",
    "@sentry/node": "^11.10.0",
    "@trpc/server": "^11.22.1",
    "ai": "^7.0.157",
    "argon2": "^0.45.1",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "jspdf": "^4.2.1",
    "nanoid": "^6.0.2",
    "ollama-ai-provider-v2": "^4.1.0",
    "pdfjs-dist": "^6.3.289",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "electron": ">=30.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "keywords": [
    "pos",
    "fastify",
    "drizzle",
    "sqlite",
    "electron"
  ],
  "author": {
    "name": "johnny4young",
    "email": "asesordeprogramacion@gmail.com"
  },
  "license": "MIT",
  "private": true
}

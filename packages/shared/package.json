{
  "name": "@puntovivo/shared",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./money": {
      "types": "./src/money.ts",
      "import": "./dist/money.js",
      "default": "./dist/money.js"
    },
    "./gs1": {
      "types": "./src/gs1.ts",
      "import": "./dist/gs1.js",
      "default": "./dist/gs1.js"
    },
    "./tax-split": {
      "types": "./src/tax-split.ts",
      "import": "./dist/tax-split.js",
      "default": "./dist/tax-split.js"
    },
    "./price-tier": {
      "types": "./src/price-tier.ts",
      "import": "./dist/price-tier.js",
      "default": "./dist/price-tier.js"
    },
    "./checkout-approval": {
      "types": "./src/checkout-approval.ts",
      "import": "./dist/checkout-approval.js",
      "default": "./dist/checkout-approval.js"
    },
    "./manager-approval": {
      "types": "./src/manager-approval.ts",
      "import": "./dist/manager-approval.js",
      "default": "./dist/manager-approval.js"
    },
    "./roles": {
      "types": "./src/roles.ts",
      "import": "./dist/roles.js",
      "default": "./dist/roles.js"
    },
    "./unit-math": {
      "types": "./src/unit-math.ts",
      "import": "./dist/unit-math.js",
      "default": "./dist/unit-math.js"
    },
    "./vertical-presets": {
      "types": "./src/vertical-presets.ts",
      "import": "./dist/vertical-presets.js",
      "default": "./dist/vertical-presets.js"
    },
    "./vertical-product-templates": {
      "types": "./src/vertical-product-templates.ts",
      "import": "./dist/vertical-product-templates.js",
      "default": "./dist/vertical-product-templates.js"
    },
    "./units": {
      "types": "./src/units.ts",
      "import": "./dist/units.js",
      "default": "./dist/units.js"
    },
    "./operational-readiness": {
      "types": "./src/operational-readiness.ts",
      "import": "./dist/operational-readiness.js",
      "default": "./dist/operational-readiness.js"
    },
    "./realtime-sse": {
      "types": "./src/realtime-sse.ts",
      "import": "./dist/realtime-sse.js",
      "default": "./dist/realtime-sse.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "ci": "pnpm run typecheck && pnpm run test && pnpm run build",
    "clean": "node ../../scripts/clean-paths.mjs dist"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}

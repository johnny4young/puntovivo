{
  "name": "@puntovivo/desktop",
  "version": "1.13.0",
  "private": true,
  "type": "module",
  "description": "Puntovivo Desktop Application - POS Solutions",
  "desktopName": "Puntovivo.desktop",
  "main": ".vite/build/index.cjs",
  "scripts": {
    "prepare:server": "pnpm --filter @puntovivo/server run build",
    "native:ensure:electron": "pnpm run electron:ensure:binary && node ../../scripts/ensure-native-runtime.mjs electron",
    "native:ensure:node": "node ../../scripts/ensure-native-runtime.mjs node",
    "electron:ensure:binary": "node ../../scripts/ensure-electron-binary.mjs",
    "electron:ensure:migrations": "node ../../scripts/ensure-migrations-bundled.mjs",
    "build:main": "node ../../scripts/build-electron-main.mjs",
    "preflight:desktop": "pnpm run prepare:server && pnpm run electron:ensure:migrations && pnpm run native:ensure:electron",
    "dev:desktop": "pnpm run preflight:desktop && electron-forge start",
    "dev:desktop:debug": "pnpm run preflight:desktop && ELECTRON_ENABLE_LOGGING=1 electron-forge start -- --inspect=5858",
    "dev:desktop:debug-brk": "pnpm run preflight:desktop && ELECTRON_ENABLE_LOGGING=1 electron-forge start -- --inspect-brk=5858",
    "dev:desktop:server-logs": "DEBUG=fastify:* pnpm run dev:desktop",
    "rebuild": "pnpm run native:ensure:electron",
    "prebuild:desktop": "pnpm run prepare:server && pnpm run electron:ensure:migrations && pnpm --filter @puntovivo/web run build && pnpm run build:main",
    "package:desktop": "pnpm run prebuild:desktop && pnpm run native:ensure:electron && electron-builder --dir -c.mac.identity=-",
    "make:desktop": "pnpm run prebuild:desktop && pnpm run native:ensure:electron && electron-builder --publish never",
    "smoke:desktop:packaged": "node ../../scripts/run-desktop-smoke.mjs --against-packaged out-builder --structure-only",
    "lint": "eslint .",
    "test": "pnpm run native:ensure:node && node --import ./src/main/__tests__/setup.mjs --test --experimental-strip-types \"src/main/**/*.test.ts\"",
    "profile:backup:ci": "node --expose-gc --experimental-strip-types ../../scripts/profile-backup-streaming.mjs --profile ci --strict",
    "profile:backup:release": "node --expose-gc --experimental-strip-types ../../scripts/profile-backup-streaming.mjs --profile release --strict",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/clean-paths.mjs .vite out node_modules",
    "clean:cache": "node ../../scripts/clean-paths.mjs .vite && pnpm run dev:desktop"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "electron",
    "desktop",
    "retail"
  ],
  "author": {
    "name": "johnny4young",
    "email": "asesordeprogramacion@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@electron/rebuild": "4.2.0",
    "@puntovivo/server": "workspace:*",
    "archiver": "^8.0.0",
    "electron-updater": "^6.8.9",
    "sanitize-html": "^2.17.7",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/unzipper": "^0.10.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jszip": "^3.10.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
